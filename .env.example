# Chỉ là mẫu; Django KHÔNG tự đọc file .env. Hosting cần inject environment.
# Thay toàn bộ placeholder; không commit file .env thật.
DJANGO_SETTINGS_MODULE=REPLACE_WITH_config.production
DJANGO_SECRET_KEY=REPLACE_WITH_RANDOM_PRODUCTION_ONLY_SECRET
DJANGO_ALLOWED_HOSTS=REPLACE_WITH_EXACT_COMMA_SEPARATED_HOSTS
DJANGO_CSRF_TRUSTED_ORIGINS=REPLACE_WITH_EXACT_HTTPS_ORIGINS
# config.production dùng SQLite; Render/PostgreSQL xem deploy/render.env.example.
DJANGO_DATABASE_ENGINE=REPLACE_WITH_sqlite
DJANGO_DATABASE_PATH=REPLACE_WITH_ABSOLUTE_PRIVATE_PERSISTENT_SQLITE_PATH
# Chỉ dùng persistent sau khi đã kiểm storage thực tế của hosting.
DJANGO_DATABASE_STORAGE=REPLACE_WITH_persistent
DJANGO_STATIC_ROOT=REPLACE_WITH_ABSOLUTE_COLLECTSTATIC_DIRECTORY
DJANGO_INFERENCE_DIR=REPLACE_WITH_ABSOLUTE_PRIVATE_MINIMAL_BUNDLE_DIRECTORY
DJANGO_WSGI_PORT=REPLACE_WITH_LOOPBACK_PORT
# direct hoặc nginx-loopback-tls; chưa xác định hosting thì giữ direct.
DJANGO_TRANSPORT_PROFILE=REPLACE_WITH_direct
# Chỉ cần cho profile nginx-loopback-tls sau xác minh topology trong tài liệu.
DJANGO_PROXY_PROFILE_CONFIRMED=REPLACE_WITH_1_ONLY_AFTER_HOSTING_REVIEW
