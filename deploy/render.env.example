# Chỉ placeholder; không source trực tiếp, không dùng với config.production SQLite.
# Render Dashboard cấp env; không commit bản thật.
DJANGO_SETTINGS_MODULE=REPLACE_WITH_config.render
PYTHON_VERSION=REPLACE_WITH_3.13.16
DJANGO_SECRET_KEY=REPLACE_WITH_SEPARATE_RANDOM_SECRET_AT_LEAST_50_CHARACTERS
DJANGO_ALLOWED_HOSTS=REPLACE_WITH_EXACT_SERVICE_HOSTNAME
DJANGO_CSRF_TRUSTED_ORIGINS=REPLACE_WITH_HTTPS_SERVICE_ORIGIN
DATABASE_URL=REPLACE_WITH_POSTGRES_INTERNAL_DATABASE_URL_FROM_RENDER
DJANGO_MODEL_RELEASE_TAG=REPLACE_WITH_PUBLISHED_PRIVATE_RELEASE_TAG
DJANGO_MODEL_BUNDLE_SHA256=REPLACE_WITH_LOCAL_ARCHIVE_SHA256
GITHUB_ARTIFACT_TOKEN=REPLACE_WITH_FINE_GRAINED_READ_ONLY_TOKEN_FOR_THIS_REPO
# RENDER=true, PORT và RENDER_EXTERNAL_HOSTNAME do Render cấp; không tự nhập giả.
# Không cần các biến DJANGO_DATABASE_ENGINE/PATH/STORAGE của config.production.
