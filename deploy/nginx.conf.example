# MẪU server blocks trong http {}; chưa cài/chạy, phải thay placeholder.
# Chỉ profile này mới tương ứng nginx-loopback-tls ở serve_production.py.
server {
    listen 80;
    server_name REPLACE_WITH_DOMAIN;
    return 308 https://REPLACE_WITH_DOMAIN$request_uri;
}
server {
    listen 443 ssl;
    server_name REPLACE_WITH_DOMAIN;
    ssl_certificate REPLACE_WITH_CERTIFICATE_PATH;
    ssl_certificate_key REPLACE_WITH_PRIVATE_KEY_PATH;
    client_max_body_size 3m;
    # Không ghi query chứa mô tả lọc giao dịch vào access log mặc định.
    access_log off;
    location /static/ {
        alias REPLACE_WITH_COLLECTSTATIC_DIRECTORY/;
        autoindex off;
    }
    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto "";
        proxy_set_header X-Forwarded-For "";
        proxy_set_header Forwarded "";
    }
}
